{
  "name": "verify1st",
  "version": "1.0.0",
  "description": "Open-source multilingual anti-scam assistant and experimental enterprise evidence lab for vLEI and x402 preflight",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://verify1st.tw",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokimiSpace/verifyfirst.git"
  },
  "bugs": {
    "url": "https://github.com/TokimiSpace/verifyfirst/issues"
  },
  "keywords": [
    "anti-scam",
    "fraud-detection",
    "phishing",
    "taiwan",
    "gemini",
    "ai",
    "react",
    "vite",
    "x402",
    "vlei"
  ],
  "scripts": {
