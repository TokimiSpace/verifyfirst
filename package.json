    "build": "vite build",
    "docs:diagrams": "node scripts/render-readme-diagrams.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@ifandonlyif/x402-preflight": "0.2.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
