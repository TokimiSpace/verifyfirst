# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gogolook Anti-Scam API Key (AWS Hackathon 2026)
GOGOLOOK_API_KEY=your_gogolook_api_key_here

# Vercel Blob Storage (auto-configured on Vercel, only needed for local development)
# BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Blob budget controls
# BLOB_CACHE_ENABLED=true       # set false to pause analyze-result cache (no head/put ops on Blob)
# RATE_LIMIT_BACKEND=memory     # memory (default) or blob
# ML_DATA_BLOB_ENABLED=false    # set true only if you want full raw ML records in Blob
# ML_DATA_SAMPLE_RATE=1         # 0-1, used only when ML_DATA_BLOB_ENABLED=true
# BLOB_PUBLIC_BASE_URL=         # optional override, e.g. https://<store>.public.blob.vercel-storage.com
