# The enterprise vLEI/x402 lab and local simulations require no private API key.
# Gemini is required only for live To C AI analysis.
# Google Gemini API Key (To C live analysis)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini cost controls
# GEMINI_MODEL=gemini-2.5-flash   # override the analysis model without a deploy
# GEMINI_THINKING_BUDGET=         # unset = model default (dynamic thinking);
                                  # 0 = disable thinking (cheapest/fastest, slightly shallower analysis)

# Optional To C verification sources
# GOOGLE_SAFE_BROWSING_KEY=
# VIRUSTOTAL_API_KEY=
# COFACTS_APP_ID=VERIFYFIRST_AI

# Optional human-labeling webhook. This sends content-free metrics only
# (language, input type/length, scores, decision, and risk-signal types). It
# never sends raw input, sanitized input, narrative text, or quoted evidence.
# Leave unset unless your deployment has reviewed and disclosed the data flow.
# GOOGLE_SHEETS_WEBHOOK_URL=

# Optional server-side observation of caller-supplied URLs. Defaults off.
# Enable only in a runtime with isolated/restricted outbound network access;
# application-level hostname checks alone cannot fully stop DNS rebinding.
# ENABLE_URL_OBSERVATION=false

# Optional rate-limit bypass for trusted server-to-server callers. Use a strong
# secret in the X-Bot-Key header; never expose it in browser code.
# BOT_API_KEY=

# IFF x402 preflight (optional; production URL is the default and needs no API key)
# IFF_BASE_URL=https://ifandonlyif.io
# Cross-origin browser access is disabled by default. To allow one separate web
# app, provide its exact HTTPS origin (no path, wildcard, query, or fragment).
# X402_ALLOWED_ORIGIN=https://payments.example.com

# Optional public telemetry flag. Defaults off for self-hosters.
# VITE_ENABLE_VERCEL_ANALYTICS=false

# Optional self-hosted Tesseract.js browser assets. When omitted, screenshot
# OCR uses tesseract.js defaults, which may download worker/core/language files
# from its public CDN at first use. These are public URLs, never secrets.
# VITE_TESSERACT_WORKER_PATH=/ocr/worker.min.js
# VITE_TESSERACT_CORE_PATH=/ocr/tesseract-core-simd-lstm.wasm.js
# VITE_TESSERACT_LANG_PATH=/ocr/lang-data

# Warm-instance cache size (no external storage operations)
# MEMORY_CACHE_MAX_ENTRIES=200  # default 200, capped at 2000
# MEMORY_RATE_LIMIT_MAX_ENTRIES=5000  # default 5000, capped at 20000
